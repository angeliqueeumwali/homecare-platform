# Database connection (required - no defaults)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=homecare
DATABASE_USER=homecare
DATABASE_PASSWORD=CHANGE_ME

# Database SSL mode: "require" for TLS-only providers such as Neon;
# "disable" for a local PostgreSQL without SSL
DATABASE_SSLMODE=disable

# JWT authentication (JWT_SECRET_KEY has an insecure development default; always override in production)
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Upload limits
MAX_IMAGES_PER_REQUEST=5
MAX_IMAGE_UPLOAD_BYTES=5242880

# Password reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_DEV_RETURN_TOKEN=false

# Contact form
CONTACT_RATE_LIMIT_PER_HOUR=5
CONTACT_MIN_MESSAGE_LENGTH=10

# CORS origins allowed to make credentialed requests (comma-separated).
# Production: set to the deployed website and dashboard URLs only.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Local acceptance seed script only (development machine use only)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_PROVIDER_PASSWORD=
